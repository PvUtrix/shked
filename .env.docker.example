# Переменные окружения для Docker Compose

# PostgreSQL конфигурация
POSTGRES_USER=shked
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=shked
POSTGRES_PORT=5432

# Порт приложения
APP_PORT=3000

# Порт Adminer (опционально)
ADMINER_PORT=8080

# NextAuth конфигурация
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Node окружение
NODE_ENV=production

# Optional bot and assistant secrets (leave empty to disable)
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
GIGACHAT_API_KEY=
